#!/bin/bash
# ============================================================
# RNA-Seq 分析流程模板（极简版）
# 用法: ./rnaseq-pipeline.lsf sample_name read1.fq read2.fq
# ============================================================

if [ $# -lt 3 ]; then
    echo "Usage: $0 <sample_name> <read1.fq> <read2.fq>"
    exit 1
fi

SAMPLE=$1
READ1=$2
READ2=$3

STAR_INDEX="/path/to/star/index"
GTF="/path/to/annotation.gtf"
OUTPUT_DIR="./${SAMPLE}_results"

mkdir -p "$OUTPUT_DIR"

echo "RNA-Seq Pipeline for: $SAMPLE"
echo "Start: $(date)"

# Step 1: STAR比对（使用集群已安装的STAR）
bsub -K -J "${SAMPLE}_star" -q normal -n 8 -R "span[hosts=1]" \
    -o "${OUTPUT_DIR}/01_star.out" -e "${OUTPUT_DIR}/01_star.err" \
    "module load STAR/2.6.0a-foss-2016b && \
     STAR --runThreadN 8 --genomeDir $STAR_INDEX --readFilesIn $READ1 $READ2 \
     --readFilesCommand zcat --outSAMtype BAM SortedByCoordinate \
     --outFileNamePrefix ${OUTPUT_DIR}/${SAMPLE}. --sjdbGTFfile $GTF"

# Step 2: 提取唯一比对（使用集群已安装的samtools）
bsub -K -J "${SAMPLE}_unique" -q normal -n 1 -R "span[hosts=1]" \
    -o "${OUTPUT_DIR}/02_unique.out" -e "${OUTPUT_DIR}/02_unique.err" \
    "module load SAMtools/1.3 && \
     samtools view -h ${OUTPUT_DIR}/${SAMPLE}.Aligned.sortedByCoord.out.bam | \
     grep -E '@|NH:i:1' | samtools view -bS - > ${OUTPUT_DIR}/${SAMPLE}.uniq.bam"

# Step 3: 排序和索引
bsub -K -J "${SAMPLE}_sort" -q normal -n 2 -R "span[hosts=1]" \
    -o "${OUTPUT_DIR}/03_sort.out" -e "${OUTPUT_DIR}/03_sort.err" \
    "module load SAMtools/1.3 && \
     samtools sort -@2 ${OUTPUT_DIR}/${SAMPLE}.uniq.bam -o ${OUTPUT_DIR}/${SAMPLE}.bam && \
     samtools index ${OUTPUT_DIR}/${SAMPLE}.bam"

# Step 4: HTSeq计数（使用集群已安装的htseq-count）
bsub -K -J "${SAMPLE}_count" -q normal -n 1 -R "span[hosts=1]" \
    -o "${OUTPUT_DIR}/04_count.out" -e "${OUTPUT_DIR}/04_count.err" \
    "module load HTSeq/0.8.0 && \
     htseq-count -f bam -s no ${OUTPUT_DIR}/${SAMPLE}.bam $GTF > ${OUTPUT_DIR}/${SAMPLE}.counts.txt"

# 清理
rm -f "${OUTPUT_DIR}/${SAMPLE}.uniq.bam"

echo "Pipeline completed for: $SAMPLE"
echo "End: $(date)"
