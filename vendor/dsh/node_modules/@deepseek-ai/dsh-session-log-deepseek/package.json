{
  "name": "@deepseek-ai/dsh-session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-log-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-command-feedback": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-message-feedback": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.5"
  }
}