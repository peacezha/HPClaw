    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-host-directory-picker-native": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.5"
