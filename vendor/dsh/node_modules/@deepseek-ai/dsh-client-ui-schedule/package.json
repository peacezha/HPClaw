{
  "name": "@deepseek-ai/dsh-client-ui-schedule",
  "description": "Host task management page and Session reminder catalog",
  "version": "0.2.1-alpha.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-schedule"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-schedule": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}