    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.5",
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.5",
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-alpha.5"
  },
