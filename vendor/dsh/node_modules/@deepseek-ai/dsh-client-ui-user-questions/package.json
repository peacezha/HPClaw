{
  "name": "@deepseek-ai/dsh-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "clsx": "^2.0.0",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}