{
  "name": "@deepseek-ai/dsh-web-frontend",
  "description": "Web application entry: vite build over the @deepseek-ai/dsh-client-web shell library; dist/ served by apps/cli's dsh web",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.5-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-deliverables": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-web": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-pwsh-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-webworker-packer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-webworker-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-remote-mock": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-workspace-changes": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-auto-review": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-cot-translation-bundle": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-experimental-plugin-market-bundle": "0.2.1-alpha.5"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @deepseek-ai/dsh-experimental-webworker-runtime exec tsdown && pnpm --filter @deepseek-ai/dsh-experimental-webworker-packer exec tsdown && vite build && dsh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  }
}