{
  "name": "@deepseek-ai/dsh-web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-alpha.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "ipaddr.js": "^2.5.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-alpha.5"
  }
}