{
  "name": "@deepseek-ai/dsh-client-ui-subagent",
  "description": "Subagent conversation catalog, continuation routing UI, and '@' reference source",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-resources": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.5",
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}