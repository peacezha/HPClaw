{
  "name": "@deepseek-ai/dsh-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-hmr": "0.2.1-alpha.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.5",
    "yaml": "^2.8.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-hmr": "0.2.1-alpha.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10-alpha.2",
    "@types/js-yaml": "^4.0.9",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-hmr": {
      "optional": true
    }
  }
}