{
  "name": "@deepseek-ai/dsh-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5"
  }
