{
  "name": "@deepseek-ai/dsh-client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input, message-image, and trajectory image slots",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-attachment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.5",
    "clsx": "^2.0.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}