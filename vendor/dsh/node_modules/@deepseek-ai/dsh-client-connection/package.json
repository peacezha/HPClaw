{
  "name": "@deepseek-ai/dsh-client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "zod": "4.4.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5"
  }
}