{
  "name": "@deepseek-ai/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5"
  }
