{
  "name": "@deepseek-ai/dsh-plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/cosmokit": "~1.8.6-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
    "@types/semver": "^7.8.0"
  }
}