{
  "name": "@deepseek-ai/dsh-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-output-retention": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-spill": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-spill": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-output-retention": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-spill": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-spill-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5"
  }
}