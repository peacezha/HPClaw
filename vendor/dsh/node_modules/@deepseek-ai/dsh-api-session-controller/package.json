    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-file-reference": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-native-command": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
