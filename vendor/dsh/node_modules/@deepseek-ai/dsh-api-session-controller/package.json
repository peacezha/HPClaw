    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-file-reference": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
