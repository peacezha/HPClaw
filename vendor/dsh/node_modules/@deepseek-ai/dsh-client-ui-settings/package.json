{
  "name": "@deepseek-ai/dsh-client-ui-settings",
  "description": "Settings domain base plugin: shared configuration forms and the canonical settings slot-type contract",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}