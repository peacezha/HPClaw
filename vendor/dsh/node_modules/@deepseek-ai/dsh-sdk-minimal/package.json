{
  "name": "@deepseek-ai/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "~1.1.7-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sdk-app": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-log-deepseek": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-terminal": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-terminal-bash": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-working-directory": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  }
}